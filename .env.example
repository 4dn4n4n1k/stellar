# Database connection string (PostgreSQL)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/stellar_db

# Secret used to encrypt Payload tokens and sessions (at least 32 characters)
PAYLOAD_SECRET=replace_this_with_a_secure_random_string_at_least_32_chars

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
